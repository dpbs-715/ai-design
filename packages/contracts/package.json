{
  "name": "@ai-design/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./material": {
      "types": "./src/material.ts",
      "default": "./dist/material.js"
    },
    "./module": {
      "types": "./src/module.ts",
      "default": "./dist/module.js"
    },
    "./node-tree": {
      "types": "./src/node-tree.ts",
      "default": "./dist/node-tree.js"
    },
    "./page": {
      "types": "./src/page.ts",
      "default": "./dist/page.js"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "default": "./dist/theme.js"
    },
    "./workspace": {
      "types": "./src/workspace.ts",
      "default": "./dist/workspace.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
