{
  "name": "@ai-design/materials",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "default": "./dist/descriptor.js"
    },
    "./containment": {
      "types": "./src/containment.ts",
      "default": "./dist/containment.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-design/contracts": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
