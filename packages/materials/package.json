{
  "name": "@ai-design/materials",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./descriptor": {
      "types": "./src/descriptor.ts",
      "default": "./dist/descriptor.js"
    },
    "./containment": {
      "types": "./src/containment.ts",
      "default": "./dist/containment.js"
    },
    "./schemas/business-form": {
      "types": "./src/schemas/business-form.ts",
      "default": "./dist/schemas/business-form.js"
    },
    "./schemas/table": {
      "types": "./src/schemas/table.ts",
      "default": "./dist/schemas/table.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-design/contracts": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
