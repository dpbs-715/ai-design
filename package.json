{
  "name": "ai-design-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ai-design/web",
    "dev:api": "turbo run dev --filter=@ai-design/api",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "infra:status": "docker compose -f infra/compose.yaml ps",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "devDependencies": {
    "turbo": "^2.10.7"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
